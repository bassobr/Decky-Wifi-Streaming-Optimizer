#!/bin/bash
# WiFi Optimizer - NM Dispatcher Script
# Auto-generated by WiFi Optimizer Decky plugin. Do not edit.
# Rendered from defaults/dispatcher.sh.tmpl by _render_dispatcher_script in
# main.py: all tuning values (sysctl set, driver fixes, CAKE args, txqueuelen)
# are injected from the plugin's constants so the two can never disagree.

SETTINGS_FILE="__SETTINGS_PATH__"
PLUGIN_DIR="__PLUGIN_DIR__"
ENFORCED_DIR="__ENFORCED_DIR__"
LOG_TAG="wifi-optimizer"

record_enforced() {
    # /run is root-owned tmpfs: safe against symlink planting, unlike the
    # user-writable plugin settings dir.
    mkdir -p "$ENFORCED_DIR" 2>/dev/null
    date +%s > "$ENFORCED_DIR/last_enforced" 2>/dev/null
}

# Only fire on interface up
[ "$2" != "up" ] && exit 0

# Only fire for wifi interfaces
IFACE_TYPE=$(/usr/bin/nmcli -t -f DEVICE,TYPE dev status 2>/dev/null | grep "^${1}:" | cut -d: -f2)
[ "$IFACE_TYPE" != "wifi" ] && exit 0

IFACE="$1"

# Self-removal: if plugin directory gone, clean up
if [ ! -d "$PLUGIN_DIR" ]; then
    logger -t "$LOG_TAG" "Plugin directory gone, removing dispatcher"
    rm -f "$0"
    rm -f /etc/NetworkManager/conf.d/99-wifi-optimizer.conf
    rm -f /etc/NetworkManager/conf.d/99-wifi-optimizer-backend.conf
    rm -f /etc/modprobe.d/99-wifi-optimizer.conf
    exit 0
fi

# Read all settings in one python3 call. The settings file lives in a
# user-writable directory while this script runs as root, so its content is
# untrusted here: values are reduced to fixed True/False words plus a
# sanitized driver name, the file path reaches python via argv, and nothing
# from the file is ever eval'd or interpolated into shell code.
POWER_SAVE=""
if [ -f "$SETTINGS_FILE" ] && [ -r "$SETTINGS_FILE" ]; then
    read -r POWER_SAVE BUFFER_TUNING DRIVER CAKE VOLATILE_GATE < <(python3 - "$SETTINGS_FILE" 2>/dev/null <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
def b(key, default):
    return "True" if d.get(key, default) else "False"
drv = str(d.get("driver", "unknown"))
if not drv or not drv.replace("_", "").isalnum():
    drv = "unknown"
gate = (not d.get("streaming_mode_enabled", False)) or d.get("streaming_active", False)
print(b("power_save_disabled", True), b("buffer_tuning_enabled", False), drv,
      b("cake_enabled", False), "True" if gate else "False")
PYEOF
)
fi

# Guard: settings missing, python3 failed, or no output -> safe defaults only
if [ -z "$POWER_SAVE" ]; then
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    VOLATILE_GATE="True"
    logger -t "$LOG_TAG" "Settings missing or unparsable, safe defaults only"
fi

# VOLATILE_GATE: with streaming auto mode on, volatile fixes are only applied
# while a streaming app is running (streaming_active, maintained by the
# plugin's process watcher). Gate closed -> leave stock settings alone.
if [ "$VOLATILE_GATE" != "True" ]; then
    logger -t "$LOG_TAG" "Streaming auto mode: no stream active, skipping volatile fixes"
    record_enforced
    exit 0
fi

# Apply power save
if [ "$POWER_SAVE" = "True" ]; then
    /usr/bin/iw dev "$IFACE" set power_save off 2>/dev/null
    # Driver-specific sysfs fixes (generated from DRIVER_PROFILES in main.py)
__DRIVER_FIXES__
    # Disable PCIe ASPM for WiFi device (all drivers)
    WIFI_PCI=$(readlink -f /sys/class/net/"$IFACE"/device 2>/dev/null)
    if [ -d "$WIFI_PCI/link" ]; then
        for f in l0s_aspm l1_aspm l1_1_aspm l1_2_aspm l1_1_pcipm l1_2_pcipm; do
            echo 0 > "$WIFI_PCI/link/$f" 2>/dev/null
        done
        echo on > "$WIFI_PCI/power/control" 2>/dev/null
    fi
    logger -t "$LOG_TAG" "power_save off applied to $IFACE (driver=$DRIVER)"
fi

# Apply buffer tuning (values generated from SYSCTL_PARAMS in main.py)
if [ "$BUFFER_TUNING" = "True" ]; then
__SYSCTL_CMDS__
    /usr/bin/ip link set "$IFACE" txqueuelen __TXQ_TUNED__ 2>/dev/null
    logger -t "$LOG_TAG" "buffer tuning applied"
fi

# Apply CAKE QoS (args generated from CAKE_QDISC_ARGS in main.py)
if [ "$CAKE" = "True" ]; then
    /usr/bin/modprobe sch_cake 2>/dev/null || /usr/sbin/modprobe sch_cake 2>/dev/null
    if /usr/bin/tc qdisc replace dev "$IFACE" root __CAKE_ARGS__ 2>/dev/null; then
        /usr/bin/ip link set "$IFACE" txqueuelen __TXQ_CAKE__ 2>/dev/null
        logger -t "$LOG_TAG" "CAKE QoS applied (unlimited) on $IFACE"
    else
        logger -t "$LOG_TAG" "CAKE QoS failed on $IFACE (sch_cake may not be available)"
    fi
fi

# Record enforcement timestamp
record_enforced

exit 0
